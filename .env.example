# Used for Inference Endpoints API auth; also injected as model secret HF_TOKEN so engines can pull gated repos (including speculative-draft models).
HF_TOKEN=
HF_NAMESPACE=
MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
# Optional per-engine model IDs. For llama.cpp, use a GGUF model repo so HF
# Inference Endpoints selects the llama.cpp engine.
LLAMA_CPP_MODEL_ID=
VLLM_MODEL_ID=
SGLANG_MODEL_ID=
FALLBACK_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# Optional convenience alias: if set and vLLM/SGLang URLs are empty,
# pipeline uses this URL for vLLM/SGLang and disables auto-create.
TARGET_LLM_BASE_URL=
# Optional generic vLLM URL. If absent and CREATE_ENDPOINTS=true, one endpoint
# is created per vLLM optimization mode.
VLLM_ENDPOINT_URL=
# Optional generic SGLang URL. If absent and CREATE_ENDPOINTS=true, one endpoint
# is created per SGLang optimization mode.
SGLANG_ENDPOINT_URL=
# Optional per-mode endpoint overrides (recommended for true optimization ablations)
VLLM_ENDPOINT_URL_BASELINE=
VLLM_ENDPOINT_URL_KV_CACHE_QUANT=
VLLM_ENDPOINT_URL_SPEC_DECODE=
SGLANG_ENDPOINT_URL_BASELINE=
SGLANG_ENDPOINT_URL_KV_CACHE_QUANT=
SGLANG_ENDPOINT_URL_SPEC_DECODE=
# Managed HF endpoint engine/framework names (HF API: custom|pytorch|llamacpp).
LLAMA_CPP_ENDPOINT_FRAMEWORK=llamacpp
VLLM_ENDPOINT_FRAMEWORK=pytorch
SGLANG_ENDPOINT_FRAMEWORK=pytorch
# Optional endpoint hardware/settings.
ENDPOINT_ACCELERATOR=gpu
ENDPOINT_VENDOR=aws
ENDPOINT_REGION=us-east-1
ENDPOINT_TYPE=protected
ENDPOINT_INSTANCE_SIZE=x1
ENDPOINT_INSTANCE_TYPE=nvidia-l4
ENDPOINT_MIN_REPLICA=0
ENDPOINT_MAX_REPLICA=1
ENDPOINT_SCALE_TO_ZERO_TIMEOUT=60
ENDPOINT_HARDWARE_USAGE_TARGET=80
ENDPOINT_CACHE_HTTP_RESPONSES=false
ENDPOINT_NOTIFICATIONS_EMAIL=true
ENDPOINT_NOTIFICATIONS_PUSH=true
ENDPOINT_TENSOR_PARALLEL_SIZE=1
# Seconds to poll HF until endpoint status is running (default 1800). Raise when parallel spin-ups are slow.
# ENDPOINT_READY_TIMEOUT_SECONDS=3600
# llama.cpp (GGUF): container image must match llamacpp image schema; defaults track llama.cpp server defaults (port 8080).
LLAMA_CPP_ENGINE_IMAGE_URL=ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA_CPP_ENGINE_PORT=8080
LLAMA_CPP_ENGINE_HEALTH_ROUTE=/health
# If the GGUF repo has multiple quantized files at repo root, either set explicitly or leave blank to auto-pick a Q4_K_M-ish file via Hub listing.
LLAMA_CPP_GGUF_FILENAME=
# Optional llamacpp container tuning exposed by HF Inference Endpoints OpenAPI (`image.llamacpp.*`).
LLAMA_CPP_CTX_SIZE=8096
LLAMA_CPP_N_PARALLEL=1
LLAMA_CPP_THREADS_HTTP=64
# Empty = omit (use server default); set to an integer to pass through.
LLAMA_CPP_N_GPU_LAYERS=
# Optional glob pattern when a repo contains multiple shard patterns (usually leave unset for single-file GGUF).
LLAMA_CPP_GGUF_VARIANT=
VLLM_ENGINE_IMAGE_URL=vllm/vllm-openai:v0.16.0
SGLANG_ENGINE_IMAGE_URL=lmsysorg/sglang:v0.5.8
VLLM_ENGINE_PORT=8000
SGLANG_ENGINE_PORT=30000
VLLM_ENGINE_HEALTH_ROUTE=/health
SGLANG_ENGINE_HEALTH_ROUTE=/health
# Optional shell-style endpoint args. Defaults follow the reference endpoint.py.
LLAMA_CPP_BASELINE_ARGS=
VLLM_BASELINE_ARGS=
VLLM_KV_CACHE_QUANT_ARGS=
# If unset, defaults build vLLM v0.16+ `--speculative_config JSON` from SPECULATIVE_DRAFT_MODEL + SPECULATIVE_NUM_TOKENS.
VLLM_SPEC_DECODE_ARGS=
SGLANG_BASELINE_ARGS=
SGLANG_KV_CACHE_QUANT_ARGS=
# If unset, defaults build SGLang STANDALONE speculative args from SPECULATIVE_DRAFT_MODEL + SPECULATIVE_NUM_TOKENS.
SGLANG_SPEC_DECODE_ARGS=
CREATE_ENDPOINTS=true
SHUTDOWN_MODE=pause
# When true, HF endpoints for all (engine, mode) pairs are created/polled concurrently (up to 16 workers).
PARALLEL_ENDPOINT_PROVISION=true
RUN_BACKENDS_SEQUENTIALLY=true
# Add llama_cpp when LLAMA_CPP_ENDPOINT_URL points at a server or CREATE_ENDPOINTS=true.
# ENGINES=llama_cpp,vllm,sglang
ENGINES=vllm,sglang
OPTIMIZATION_MODES=baseline
REPEATS_PER_CONDITION=1
# Optional manual llama.cpp endpoint URL. If absent and CREATE_ENDPOINTS=true,
# the manager creates a managed llama.cpp endpoint from LLAMA_CPP_MODEL_ID/MODEL_ID.
LLAMA_CPP_ENDPOINT_URL=
# vLLM --kv-cache-dtype; SGLang default maps bare fp8 -> fp8_e4m3 (SGLang does not accept `fp8` alone).
KV_CACHE_QUANT_MODE=fp8
# Overrides SGLang --kv-cache-dtype when unset (e.g. fp8_e4m3). Optional.
SGLANG_KV_CACHE_QUANT_DTYPE=
# Used by vLLM/SGLang spec_decode optimization mode defaults when explicit *_SPEC_DECODE_ARGS are not provided.
SPECULATIVE_DRAFT_MODEL=
# Fallback draft when SPECULATIVE_DRAFT_MODEL is empty (still required for speculative endpoints).
SPECULATIVE_DRAFT_MODEL_DEFAULT=meta-llama/Llama-3.2-1B-Instruct
# vLLM: maps to speculative_config.num_speculative_tokens; SGLang: maps to --speculative-num-steps when using defaults.
SPECULATIVE_NUM_TOKENS=5
APPLY_OPTIMIZATION_REQUEST_HINTS=false
STANDARD_EVAL_ENABLED=true
STANDARD_EVALUATOR=lm_eval
STANDARD_EVAL_TASKS=gsm8k
# Online benchmark-heavy option:
# STANDARD_EVAL_TASKS=gsm8k_platinum,hendrycks_math500,minerva_math,humaneval_instruct
STANDARD_EVAL_RUN_ON_ALL_CONDITIONS=false
STANDARD_EVAL_LIMIT_OVERRIDE=0
# Empty = all tasks in config/default.yaml. For one comparable stream with stratification
# across modes, use scripts/run_single_workload_gsm8k.sh or e.g. gsm8k_main only:
# PUBLIC_TASK_IDS=gsm8k_main
PUBLIC_TASK_IDS=
LIMIT=100
SMOKE_LIMIT=8
TEMPERATURE=0.0
TOP_P=1.0
MAX_NEW_TOKENS=256
PUBLIC_BENCHMARK_ENABLED=true
CUSTOM_WORKLOAD_ENABLED=true
# Set false if you want online benchmarks only.
# CUSTOM_WORKLOAD_ENABLED=false
CUSTOM_WORKLOAD_SIZE=45
RESULTS_DIR=results
RUN_NAME=black_box_inference_backends
MAX_ESTIMATED_COST_USD=10
AIPERF_ENABLED=true
AIPERF_SYNTHETIC_ENABLED=true
REQUEST_TIMEOUT_SECONDS=120
BACKEND_API_STYLE=auto
